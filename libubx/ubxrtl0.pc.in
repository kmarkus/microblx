prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: librtlog_client
Description: Client library for real-time logging
URL: https://github.com/kmarkus/microblx
Version: @PROJECT_VERSION@
Cflags: -I${includedir} -I${includedir}/ubx
Libs: -L${libdir} -lrtlog_client

-- -*- lua -*-
--
-- one ubx/ramp per supported type

local bd = require("blockdiagram")
return bd.system
{
   imports = { "stdtypes", "ramp" },

   blocks = {
      { name="float_ramp", type="ubx/ramp" },
      { name="double_ramp", type="ubx/ramp" },
      { name="uint8_ramp", type="ubx/ramp" },
      { name="uint16_ramp", type="ubx/ramp" },
      { name="uint32_ramp", type="ubx/ramp" },
      { name="uint64_ramp", type="ubx/ramp" },
      { name="int8_ramp", type="ubx/ramp" },
      { name="int16_ramp", type="ubx/ramp" },
      { name="int32_ramp", type="ubx/ramp" },
      { name="int64_ramp", type="ubx/ramp" },
   },

   configurations = {
      { name="float_ramp", config = { type="float", start=10, slope=0.25 } },
      { name="double_ramp", config = { type="double", start=999.9, slope=0.1 } },
      { name="uint8_ramp", config = { type="uint8_t", start=1, slope=1 } },
      { name="uint16_ramp", config = { type="uint16_t", start=1, slope=1 } },
      { name="uint32_ramp", config = { type="uint32_t", start=1, slope=100 } },
      { name="uint64_ramp", config = { type="uint64_t", start=1700000000000000001ULL, slope=1000 } },
      { name="int8_ramp", config = { type="int8_t", start=-100, slope=1 } },
      { name="int16_ramp", config = { type="int16_t", start=1, slope=1 } },
      { name="int32_ramp", config = { type="int32_t", start=-10, slope=-100 } },
      { name="int64_ramp", config = { type="int64_t", start=-1000, slope=1 } },
   },
}

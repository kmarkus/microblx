local parser = optparse(help)
local arg, opts = parser:parse(arg)

if #arg>0 then
   errexit(1, "invalid arg: %s, try -h", table.concat(arg, ", "))
end

local bustyp = 'default'
if opts.system then
   bustyp = 'default_system'
elseif opts.session then
   bustyp = 'default_user'
end

bus = lsdb.open(bustyp)

local handled = false
local ndname = opts.node or 'n'
local use_colors = not opts.no_colors
local use_raw = opts.raw

-- wrap s in color c, or return s plain when colors disabled
local function C(c, s) return use_colors and (c .. s .. ac.reset) or s end

local rpad = utils.rpad

-- format an array of strings, one per line
local function format_list(t)
   if #t == 0 then return "(none)" end
   local lines = {}
   for _, s in ipairs(t) do lines[#lines+1] = "  " .. s end
   return "\n" .. table.concat(lines, '\n')
end

-- format modules: array of {id, license} pairs
local function format_modules(mods)
   if #mods == 0 then return "(none)" end
   local maxw = 0
   for _, m in ipairs(mods) do maxw = math.max(maxw, #m[1]) end
   local lines = {}
   for _, m in ipairs(mods) do
      lines[#lines+1] = fmt("  %s  %s", C(ac.cyan, rpad(m[1], maxw)), m[2])
   end
   return "\n" .. table.concat(lines, '\n')
end

-- format cblocks: array of {name, prototype, state} triples; steps from GetBlockInfo
local function format_cblocks(cblocks, steps)
   if #cblocks == 0 then return "(none)" end
   local maxname, maxproto = 0, 0
   for _, b in ipairs(cblocks) do
      maxname  = math.max(maxname,  #b[1])
      maxproto = math.max(maxproto, #b[2])
   end
   local state_color = { active='green', inactive='yellow', preinit='red' }
   local lines = {}
   for _, b in ipairs(cblocks) do
      local sc = use_colors and ac[state_color[b[3]] or 'white'] or nil
      local s = steps and steps[b[1]]
      lines[#lines+1] = fmt("  %s  %s  %s%s",
         C(ac.cyan, rpad(b[1], maxname)),
         rpad(b[2], maxproto),
         sc and (sc .. b[3] .. ac.reset) or b[3],
         s and fmt("  steps:%d", s) or "")
   end
   return "\n" .. table.concat(lines, '\n')
end

-- group raw connections (iblk-centric) into cblock.port -[iblk r:N w:N]-> cblock.port lines
-- iblk_stats: optional map of iblk_name -> {reads, writes} from GetBlockInfo calls
local function format_connections(conns, iblk_stats)
   local iblk_map = {}
   for _, conn in ipairs(conns) do
      if type(conn.from) == 'table' then
         local iblk = conn.to
         iblk_map[iblk] = iblk_map[iblk] or {}
         iblk_map[iblk].from = conn.from
      else
         local iblk = conn.from
         iblk_map[iblk] = iblk_map[iblk] or {}
         iblk_map[iblk].to = conn.to
      end
   end
   local lines = {}
   for iblk, conn in pairs(iblk_map) do
      local src = conn.from and fmt("%s.%s", conn.from[1], conn.from[2]) or "?"
      local tgt = conn.to   and fmt("%s.%s", conn.to[1],   conn.to[2])   or "?"
      local st = iblk_stats and iblk_stats[iblk]
      local label = st and fmt("%s r:%d w:%d", iblk, st.reads, st.writes) or iblk
      local arrow = C(ac.green, fmt("-[%s]->", label))
      lines[#lines+1] = fmt("  %s %s %s", C(ac.cyan, src), arrow, C(ac.cyan, tgt))
   end
   table.sort(lines)
   return #lines > 0 and ("\n" .. table.concat(lines, '\n')) or "(none)"
end

-- pretty-print a single block's GetBlockInfo result
local function format_block_info(info)
   local lines = {}
   local state_color = { active='green', inactive='yellow', preinit='red' }
   local sc = use_colors and ac[state_color[info.state] or 'white'] or nil
   local proto = (info.prototype and info.prototype ~= false) and info.prototype or "(proto)"

   -- header
   local stat_str
   if info.stat_num_steps then
      stat_str = fmt("  steps:%d", info.stat_num_steps)
   elseif info.stat_num_reads ~= nil then
      stat_str = fmt("  r:%d w:%d", info.stat_num_reads, info.stat_num_writes)
   else
      stat_str = ""
   end
   lines[#lines+1] = fmt("%s  %s  %s%s",
      C(ac.bright, info.name), proto,
      sc and (sc .. info.state .. ac.reset) or info.state,
      stat_str)

   -- ports
   if info.ports and #info.ports > 0 then
      lines[#lines+1] = ""
      lines[#lines+1] = C(ac.yellow, "ports:")
      local maxname, maxtype = 0, 0
      for _, p in ipairs(info.ports) do
         maxname = math.max(maxname, #p.name)
         local t = p.in_type_name or p.out_type_name or ""
         maxtype = math.max(maxtype, #t + 4) -- +4 for "[N]" room
      end
      for _, p in ipairs(info.ports) do
         local dir, type_str
         if p.in_type_name and p.out_type_name then
            dir = "[in/out]"
            if p.in_type_name == p.out_type_name and p.in_data_len == p.out_data_len then
               type_str = fmt("%s[%d]", p.in_type_name, p.in_data_len)
            else
               -- distinct in/out types: show both as in->out
               type_str = fmt("%s[%d]->%s[%d]",
                              p.in_type_name, p.in_data_len,
                              p.out_type_name, p.out_data_len)
            end
         elseif p.in_type_name then
            dir = "[in]    "
            type_str = fmt("%s[%d]", p.in_type_name, p.in_data_len)
         else
            dir = "[out]   "
            type_str = fmt("%s[%d]", p.out_type_name, p.out_data_len)
         end
         local inc = (p.connections and p.connections.incoming) or {}
         local out = (p.connections and p.connections.outgoing) or {}
         local conn = {}
         if #inc > 0 then conn[#conn+1] = C(ac.green, "<-") .. " " .. table.concat(inc, ", ") end
         if #out > 0 then conn[#conn+1] = C(ac.green, "->") .. " " .. table.concat(out, ", ") end
         local doc = (p.doc and #p.doc > 0) and C(ac.dim, "  -- " .. p.doc) or ""
         lines[#lines+1] = fmt("  %s  %s  %s%s%s",
            C(ac.cyan, rpad(p.name, maxname)),
            C(ac.dim, dir),
            rpad(type_str, maxtype),
            #conn > 0 and ("  " .. table.concat(conn, "  ")) or "",
            doc)
      end
   end

   -- configs
   if info.configs and #info.configs > 0 then
      lines[#lines+1] = ""
      lines[#lines+1] = C(ac.yellow, "configs:")
      local maxname, maxtype = 0, 0
      for _, c in ipairs(info.configs) do
         maxname = math.max(maxname, #c.name)
         maxtype = math.max(maxtype, #c.type_name)
      end
      for _, c in ipairs(info.configs) do
         local val_str = c.value ~= nil and ("  " .. pt.tostr(c.value)) or ""
         local doc = (c.doc and #c.doc > 0) and C(ac.dim, "  -- " .. c.doc) or ""
         lines[#lines+1] = fmt("  %s  %s%s%s",
            C(ac.cyan, rpad(c.name, maxname)),
            rpad(c.type_name, maxtype),
            val_str, doc)
      end
   end

   if info.meta_data and #info.meta_data > 0 then
      lines[#lines+1] = ""
      lines[#lines+1] = fmt("%s %s", C(ac.yellow, "meta_data:"), info.meta_data)
   end

   return table.concat(lines, '\n')
end

if opts.info then
   local p = get_proxy(ndname)

   if opts.info == true then
      if use_raw then
         printf("node:         %s", p.Node)
         printf("modules:      %s", pt.tostr(p.Modules))
         printf("cblock types: %s", pt.tostr(p.CBlockTypes))
         printf("iblock types: %s", pt.tostr(p.IBlockTypes))
         printf("cblocks:      %s", pt.tostr(p.CBlocks))
         printf("connections:  %s", pt.tostr(p.Connections))
      else
         local function lbl(s) return C(ac.yellow, s) end
         -- collect unique iblock names from connections
         local iblk_names = {}
         for _, conn in ipairs(p.Connections) do
            local name = type(conn.from) == 'table' and conn.to or conn.from
            iblk_names[name] = true
         end
         -- fetch stats for each iblock and each cblock via GetBlockInfo
         local iblk_stats, cblk_steps = {}, {}
         for name in pairs(iblk_names) do
            local info = p('GetBlockInfo', name)
            iblk_stats[name] = { reads=info.stat_num_reads, writes=info.stat_num_writes }
         end
         for _, b in ipairs(p.CBlocks) do
            local info = p('GetBlockInfo', b[1])
            cblk_steps[b[1]] = info.stat_num_steps
         end
         printf("%s %s", lbl("node:        "), C(ac.bright, p.Node))
         printf("%s %s", lbl("modules:     "), format_modules(p.Modules))
         printf("%s %s", lbl("cblock types:"), format_list(p.CBlockTypes))
         printf("%s %s", lbl("iblock types:"), format_list(p.IBlockTypes))
         printf("%s %s", lbl("cblocks:     "), format_cblocks(p.CBlocks, cblk_steps))
         printf("%s %s", lbl("connections: "), format_connections(p.Connections, iblk_stats))
      end
   else
      local info = p('GetBlockInfo', opts.info)
      print(use_raw and pt.tostr(info) or format_block_info(info))
   end
   handled = true
end

if opts.module then
   local p = get_proxy(ndname)
   p('LoadModule', opts.module)
   handled = true
end

if opts.create then
   local p = get_proxy(ndname)
   local args = split(opts.create)
   if #args ~= 3 then
      errexit(1, "invalid arg: %s, expected NAME:TYPE:{CONFIG}", opts.create)
   end
   local cfg = str2lua(args[3])
   p('CreateBlock', args[1], args[2], lsdb.tovariant2(cfg))
   handled = true
end

if opts.remove then
   local p = get_proxy(ndname)
   p('RemoveBlock', opts.remove)
   handled = true
end

if opts.switch_state then
   local p = get_proxy(ndname)
   local args = split(opts.switch_state)
   if #args < 2 then
      errexit(1, "invalid arg: %s, expected BLOCK,STATE", opts.switch_state)
   end
   p('SwitchState', args[1], args[2])
   handled = true
end

if opts.trigger or opts.periodic then

   if opts.trigger and opts.periodic then
      errexit(1, "invalid arg: can't use both --trigger and --periodic")
   end

   local num
   local p = get_proxy(ndname)
   local args = split(opts.trigger or opts.periodic)

   if #args < 1 then
      errexit(1, "invalid arg: %s, expected BLOCK", opts.trigger)
   end

   if opts.periodic then num = math.huge else num = 1 end

   while num > 0 do
      num = num - 1
      p('Trigger', args)
   end

   handled = true
end

if opts.connect then
   local p = get_proxy(ndname)
   local args = split(opts.connect)
   if #args < 3 then
      errexit(1, "invalid arg: %s, expected at least three args", opts.connect)
   end
   p('Connect',
     args[1] or "",
     args[2] or "",
     args[3] or "",
     args[4] or "",
     args[5] or "",
     lsdb.tovariant(args[6] or "")
   )
   handled = true
end

if opts.disconnect then
   errexit(1, "disconnect: not yet implemented")
end

if opts.config then
   local p = get_proxy(ndname)
   local args = split(opts.config)

   if #args == 2 then
      print(pt.tostr(p('GetConfig', args[1], args[2])))
   elseif #args == 3 then
      local v = str2lua(args[3])
      p('SetConfig', args[1], args[2], lsdb.tovariant(v))
   else
      errexit(1, "invalid number of args: %s, expected 2 or 3", #args)
   end
   handled = true
end

if opts.clear then
   local p = get_proxy(ndname)
   local keeplist = {}
   if type(opts.clear) == 'string' then
      keeplist = split(opts.clear)
   end
   p('ClearNode', keeplist)
   handled = true
end

if opts.read then
   local p = get_proxy(ndname)
   local args = split(opts.read)
   print(pt.tostr(p('Read', args[1], args[2])))
   handled = true
end

if opts.read_mon then
   local p = get_proxy(ndname)
   local args = split(opts.read_mon)
   while true do
      local v = p('Read', args[1], args[2])
      if v ~= false then
	 print(pt.tostr(v))
      end
   end
   -- handled = true
end

if opts.write then
   local p = get_proxy(ndname)
   local args = split(opts.write)
   if #args < 3 then
      errexit(1, "invalid arg: %s, expected BLOCK:PORT:VALUE", opts.write)
   end
   local v = str2lua(args[3])
   p('Write', args[1], args[2], lsdb.tovariant(v))
   handled = true
end

if opts.write_read then
   local p = get_proxy(ndname)
   local args = split(opts.write_read)
   if #args < 3 then
      errexit(1, "invalid arg: %s, expected BLOCK:PORT:VALUE[:STEP]", opts.write_read)
   end
   local blk, port = args[1], args[2]
   local do_step = args[4] == "true" or args[4] == "1"
   local v = str2lua(args[3])
   -- prime the read connection first so a value produced by the step is captured
   p('Read', blk, port)
   p('Write', blk, port, lsdb.tovariant(v))
   if do_step then p('Trigger', { blk }) end
   print(pt.tostr(p('Read', blk, port)))
   handled = true
end

if opts.load_usc then
   local p = get_proxy(ndname)
   local ext = string.match(opts.load_usc, "^.+%.(.+)$")
   local f = io.open(opts.load_usc, "r")
   if not f then
      errexit(1, "failed to open file '%s'", opts.load_usc)
   end
   local contents = f:read("*all")
   f:close()
   if ext == 'json' then
      p('LoadUSCJSON', contents)
   elseif ext == 'usc' or ext == 'lua' then
      p('LoadUSCLua', contents)
   else
      errexit(1, "unknown USC file type '%s', expected .json, .usc or .lua", ext or "")
   end
   handled = true
end

if opts.load_plugin then
   local pm = get_pm_proxy(ndname)
   pm('LoadPlugin', opts.load_plugin)
   handled = true
end

if opts.unload_plugin then
   local pm = get_pm_proxy(ndname)
   pm('UnloadPlugin', opts.unload_plugin)
   handled = true
end

if opts.list_plugins then
   local pm = get_pm_proxy(ndname)
   print(format_list(pm('ListPlugins')))
   handled = true
end

if opts.examples then
   print([[
Examples:
  # show node info (default node 'n')
  ubx-dbus -i

  # show info about a specific block
  ubx-dbus -i ptrig0

  # load a module
  ubx-dbus -m /usr/local/lib/ubx/0.9/lfrb.so

  # create a block named 'buf1' of type 'lfrb'
  ubx-dbus --create=buf1:lfrb:{data_len=8,buffer_len=4}

  # bring a block to active state
  ubx-dbus --switch-state=buf1:active

  # connect src.outport to tgt.inport via an lfrb iblock
  ubx-dbus --connect=src:outport:tgt:inport:lfrb:{}

  # get a config value
  ubx-dbus --config=ptrig0:period

  # set a config value
  ubx-dbus --config=ptrig0:period:{sec=0,nsec=100000000}

  # write a value to a port
  ubx-dbus --write=myblock:myport:42

  # read from a port
  ubx-dbus --read=myblock:myport

  # write to an in-out port and read the result back in one shot
  ubx-dbus --write-read=myblock:io:42
  # ... stepping the block in between
  ubx-dbus --write-read=myblock:io:42:true

  # load a USC model
  ubx-dbus --load-usc=mymodel.usc

  # trigger a block once, then clear all except ptrig0
  ubx-dbus --trigger=ptrig0
  ubx-dbus --clear=ptrig0

  # load a plugin by short name or absolute path
  ubx-dbus -p myplugin.lua
  ubx-dbus -p /path/to/myplugin.lua

  # list loaded plugins
  ubx-dbus -P

  # unload a plugin
  ubx-dbus -u myplugin.lua]])
   handled = true
end

if handled == false then
   errexit(1, "missing command, try -h")
end

-- -*- mode: lua; -*-

local PERIOD = bd.param("PERIOD", 1000, "ptrig period [us]", function(v)
   return v % 1 == 0 and v >= 1, "must be an integer >= 1"
end)

return bd.system {
   imports = { "stdtypes", "ptrig" },

   blocks = {
      { name="ptrig_1", type="ubx/ptrig" },
   },

   configurations = {
      { name="ptrig_1", config = {
	   period = { sec=0, usec=PERIOD },
	   tstats_mode=1,
	   tstats_profile_path="/tmp",
	   chain0={
	      { b="#controller/trig_1" } } }
      },
   }
}

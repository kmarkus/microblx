local ubx = require("ubx")
local bd = require("blockdiagram")
local utils = require("utils")
local have_optparse, optparse = pcall(require, "optparse")

local ts = tostring
local fmt = string.format

-- Export nd, bd and ubx globally
_G.ubx = ubx
_G.bd = bd

local MAXINT = 2^31 - 1

local function errexit(status, format, ...)
   io.stderr:write(fmt(format, ...), "\n")
   os.exit(status)
end

if not have_optparse then
   errexit(1, "error: the 'optparse' module is required (luarocks install optparse)")
end

local res, help = utils.preproc(
   [=[
ubx-launch $(gitver)

microblx function block model system launcher

Usage: ubx-launch [OPTIONS] {-c FILE[,FILE2] | -e}

either a model file (-c) or empty mode (-e) must be given. an empty
node is useful in conjunction with --dbus for loading the actual
model later via ubx-dbus --load-usc.

Options:
  -c, --conf=FILE[,FILE2]  .usc or .json model file(s) to launch. if multiple
                           models are given, these will be merged prior to
                           launching
      --ctype=TYPE[,TYPE2] types of the model files. either usc or json. if
                           not specified, auto-detected from extension.
                           requires the same number of parameters as -c
  -e, --empty              launch an empty node (mutually exclusive with -c)
  -b, --monitor=BLOCK      monitor BLOCK and shutdown when it becomes inactive
      --nodename=NAME      set nodename to NAME
      --mlockall           call mlockall to lock memory
      --dumpable           enable core dumps even for priviledged processes
      --nostart            instantiate and configure, but don't start
  -t, --duration=SECONDS   run for SECONDS and then shutdown
  -l, --loglevel=N         set global loglevel [0..7]
  -s, --stderr             log to stderr (in addition to ubx_log)
  -v, --verbose            verbose (will log additional, early messages to
                           stderr)
  -i, --interactive        skip waiting and node teardown (used by ubx-ilaunch)
      --dbus               create and start the dbus interface block
      --webgraph=[PORT]    create and start the webgraph block. the optional
                           port defaults to 8888
      --validate           don't run, just validate configuration file
      --check=CHK1[,CHK2]  carry out additional validation
      --werror             treat warnings as errors
      --version            print version and exit
  -h, --help               display this help and exit

available checks:
@ for k,v in pairs(checks) do
  $(k): $(v.desc)
@ end

for backwards compatibility, the legacy single-dash long options
(-ctype, -nodename, -mlockall, -dumpable, -nostart, -loglevel, -dbus,
-webgraph, -validate, -check, -werror, -version) are still accepted.
]=], {checks=bd._checks, pairs=pairs, gitver=ubx.git_version()})
assert(res, "failed to generate help string")

-- backwards compat: translate the legacy single-dash long options to
-- GNU style
local legacy_opts = {
   ["-ctype"]=true, ["-nodename"]=true, ["-mlockall"]=true,
   ["-dumpable"]=true, ["-nostart"]=true, ["-loglevel"]=true,
   ["-dbus"]=true, ["-webgraph"]=true, ["-validate"]=true,
   ["-check"]=true, ["-werror"]=true, ["-version"]=true,
}

local legacy_seen = {}

for i=1,#arg do
   if legacy_opts[arg[i]] then
      legacy_seen[#legacy_seen+1] = arg[i]
      arg[i] = "-"..arg[i]
   end
end

if #legacy_seen > 0 then
   local gnu = {}
   for i,o in ipairs(legacy_seen) do gnu[i] = "-"..o end
   io.stderr:write(fmt("warning: option(s) %s are deprecated and will be dropped in the future, please use %s\n",
		       table.concat(legacy_seen, ", "), table.concat(gnu, ", ")))
end

-- handle --version manually: optparse would print its own one-liner
for _,a in ipairs(arg) do
   if a == "--version" then
      print(ubx.version_string())
      os.exit(0)
   end
end

local parser = optparse(help)
local args, opts = parser:parse(arg)

if #args > 0 then
   errexit(1, "error: invalid argument(s): %s (see -h for help)",
	   table.concat(args, " "))
end

-- multiply given options are returned as tables: keep the last one
-- (as the legacy proc_args based parsing did)
for _,o in ipairs{"conf", "ctype", "check", "nodename", "loglevel",
		  "duration", "monitor", "webgraph"} do
   if type(opts[o]) == "table" then opts[o] = opts[o][#opts[o]] end
end

if opts.verbose then bd.VERBOSE=true end

local model

if opts.empty and opts.conf then
   errexit(1, "error: -e and -c are mutually exclusive")
end

if not opts.empty and not opts.conf then
   errexit(1, "error: no configuration file(s) given (-c option)")
end

if opts.empty then
   -- launch an empty node (e.g. for populating it later via
   -- --dbus). stdtypes is imported as a baseline, also since the
   -- --dbus and --webgraph blocks depend on it
   if opts.verbose then
      io.stderr:write("launching empty node\n")
   end
   model = bd.system{ imports={ "stdtypes" } }
else
   local conf_files = utils.split(opts.conf, ',')
   local conf_types = {}

   if opts.ctype then
      conf_types = utils.split(opts.ctype, ',')
      if #conf_files ~= #conf_types then
	 errexit(1, "error: the use of --ctype requires the same number of parameters as -c")
      end
   end

   -- load first model and merge others into it
   model = bd.load(conf_files[1], conf_types[1])

   if not bd.is_system(model) then
      print(model)
      errexit(1, "error: failed to load files %s", table.concat(conf_files, ', '))
   end

   for i=2,#conf_files do
      local m = bd.load(conf_files[i], conf_types[i])
      model:merge(m, true)
   end
end

if opts.validate then
   model:validate(true)
   os.exit(1)
end

local loglevel
if opts.loglevel then
   loglevel = tonumber(opts.loglevel)
   if loglevel == nil then
      errexit(1, "error: invalid loglevel argument '%s'", opts.loglevel)
   end
end

local checks
if opts.check then checks = utils.split(opts.check, ",") end

local core_prefix, prefixes = ubx.get_prefix()
print("core_prefix: " .. core_prefix)
print("prefixes:    " .. table.concat(prefixes, ", "))

local nd = model:launch{
   nodename = opts.nodename,
   verbose = true,
   loglevel = loglevel,
   use_stderr = opts.stderr,
   mlockall = opts.mlockall,
   dumpable = opts.dumpable,
   nostart = opts.nostart,
   checks = checks or nil,
   werror = opts.werror,
}

_G.nd = nd

if opts.empty then
   ubx.info(nd, "ubx-launch", "launched empty node")
end

if opts.dbus then
   local have_luablock, lbutil = pcall(require, "ubx/luablock-util")

   if not have_luablock then
      errexit(1, "luablock module is not available")
   end

   lbutil.create(nd, "lsdb-intf", "lsdb0", "active", true)
end

if opts.webgraph then
   local port = tonumber(opts.webgraph) or 8888
   local have_luablock, lbutil = pcall(require, "ubx/luablock-util")

   if not have_luablock then
      errexit(1, "luablock module is not available")
   end

   if opts.verbose then print("webgraph: listening on http://localhost:"..ts(port)) end
   local b = lbutil.create(nd, "webgraph", "webgraph0", nil, {period=50})
   assert(ubx.block_tostate(b, 'inactive') == 0)
   ubx.set_config(b, 'port', port)
   assert(ubx.block_tostate(b, 'active') == 0)
end

if not opts.interactive then
   local duration = MAXINT

   if opts.duration then
      duration = tonumber(opts.duration)
      if duration == nil then
	 errexit(1, "error: invalid duration argument '%s'", opts.duration)
      end
   end

   if opts.monitor then
      local monblock = nd:block_get(opts.monitor)

      while duration > 0 do
	 duration = duration - 1
	 if ubx.wait_sigint(1) == 0 then
	    print("received signal, shutting down")
	    break
	 end
	 if monblock and monblock:get_block_state() ~= 'active' then
	    break
	 end
      end
   else
      ubx.wait_sigint(duration)
   end

   model:pulldown(nd)
end

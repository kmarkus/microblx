#!/bin/sh
# Show schedstat for all threads of ubx-launch with scheduling policy.
# Samples repeatedly to find the worst-case on-CPU time per period for
# SCHED_DEADLINE threads, which is the correct basis for sizing runtime_ns.
#
# Usage: ubx-schedstat [-h] [-n COUNT] [WINDOW_S [PERIOD_HZ]]

usage() {
    cat <<EOF
usage: $(basename "$0") [OPTIONS] [WINDOW_S [PERIOD_HZ]]

Show schedstat for all threads of a running ubx-launch process.
When PERIOD_HZ is given, tracks the worst-case on-CPU time per period
across COUNT windows — use the reported max as runtime_ns baseline.

Arguments:
  WINDOW_S    duration of each sample window in seconds (default: 1)
  PERIOD_HZ   ptrig trigger rate in Hz; enables per-period budget analysis

Options:
  -n COUNT    number of sample windows to collect (default: 1)
  -h          show this help and exit

Columns:
  CPU_NS_TOTAL   cumulative on-CPU nanoseconds since thread start; excludes
                 time blocked or sleeping — exactly what CBS charges against
                 runtime_ns
  DELTA_CPU_NS   CPU time consumed during this sample window
  AVG_NS/PERIOD  DELTA_CPU_NS / periods_in_window  (requires PERIOD_HZ)
  MAX_NS/PERIOD  worst-case avg/period seen so far across all windows

Budget derivation (no arbitrary multiplier):
  Run for many windows under realistic worst-case load. The reported
  MAX_NS/PERIOD converges toward the empirical WCET. Use that value
  directly as runtime_ns, plus a small guard (e.g. +20%) for unobserved
  worst cases. No fixed multiplier needed.

Examples:
  $(basename "$0") 1 1000          # single 1s window, 1kHz ptrig
  $(basename "$0") -n 60 1 1000    # 60 windows of 1s = 1min WCET search
EOF
}

COUNT=1
while getopts "hn:" opt; do
    case $opt in
        h) usage; exit 0 ;;
        n) COUNT=$OPTARG ;;
        *) usage >&2; exit 1 ;;
    esac
done
shift $(( OPTIND - 1 ))

WINDOW_S=${1:-1}
PERIOD_HZ=${2:-}

decode_policy() {
    case $1 in
        0) echo "OTHER" ;; 1) echo "FIFO" ;; 2) echo "RR" ;;
        6) echo "DL"    ;; *) echo "?$1"  ;;
    esac
}

pid=$(pgrep -f 'luajit.*ubx-launch' | head -n 1)
[ -z "$pid" ] && { echo "error: ubx-launch not running" >&2; exit 1; }

echo "PID: $pid  window: ${WINDOW_S}s  count: ${COUNT}"
[ -n "$PERIOD_HZ" ] && echo "periods per window: $(( WINDOW_S * PERIOD_HZ ))"

# no arrays in POSIX sh: per-thread values live in snap_<tid> and
# max_<tid>, tids are numeric so the eval'd names are safe
max_tids=

window=1
while [ "$window" -le "$COUNT" ]; do
    snap_tids=
    for tid in $(ls /proc/$pid/task/ 2>/dev/null); do
        read c _ < /proc/$pid/task/$tid/schedstat 2>/dev/null || continue
        eval "snap_$tid=$c"
        snap_tids="$snap_tids $tid"
    done

    sleep "$WINDOW_S"

    [ "$COUNT" -gt 1 ] && printf "\n-- window %d/%d --\n" "$window" "$COUNT"

    printf "%-8s  %-7s  %-16s  %16s  %14s" TID POLICY COMM CPU_NS_TOTAL DELTA_CPU_NS
    [ -n "$PERIOD_HZ" ] && printf "  %14s  %14s" AVG_NS/PERIOD MAX_NS/PERIOD
    echo

    for tid in $(ls /proc/$pid/task/ 2>/dev/null); do
        comm=$(cat /proc/$pid/task/$tid/comm 2>/dev/null) || continue
        policy=$(awk '{sub(/.*\) /,""); print $39}' /proc/$pid/task/$tid/stat 2>/dev/null)
        read cpu_ns _ < /proc/$pid/task/$tid/schedstat 2>/dev/null || continue

        eval "snap=\${snap_$tid:-0}"
        delta_cpu=$(( cpu_ns - snap ))

        printf "%-8s  %-7s  %-16s  %16s  %14s" \
            "$tid" "$(decode_policy "$policy")" "$comm" "$cpu_ns" "$delta_cpu"

        if [ "$policy" = "6" ] && [ -n "$PERIOD_HZ" ] && [ "$delta_cpu" -gt 0 ]; then
            periods=$(( WINDOW_S * PERIOD_HZ ))
            avg_ns=$(( delta_cpu / periods ))
            eval "cur_max=\${max_$tid:-}"
            if [ "$avg_ns" -gt "${cur_max:-0}" ]; then
                [ -z "$cur_max" ] && max_tids="$max_tids $tid"
                cur_max=$avg_ns
                eval "max_$tid=$avg_ns"
            fi
            printf "  %14s  %14s" "$avg_ns" "$cur_max"
        fi
        echo
    done

    for tid in $snap_tids; do unset "snap_$tid"; done
    window=$(( window + 1 ))
done

if [ -n "$PERIOD_HZ" ] && [ -n "$max_tids" ]; then
    echo ""
    echo "Empirical WCET summary (worst window across $COUNT × ${WINDOW_S}s):"
    for tid in $max_tids; do
        comm=$(cat /proc/$pid/task/$tid/comm 2>/dev/null)
        eval "max=\$max_$tid"
        suggested=$(( max + max / 5 ))   # +20% guard for unobserved worst cases
        printf "  TID %-8s %-16s  max_ns/period: %6d  suggested runtime_ns (+20%%): %d\n" \
            "$tid" "$comm" "$max" "$suggested"
    done
fi
